# Скопируйте в .env (не коммитится). migrate.py читает переменные из
# окружения: `set -a; . ./.env; set +a` перед запуском.

# Роль-владелец схемы. Supabase: session pooler, порт 5432, роль flamenco_app.
DATABASE_URL=
# verify-full — с проверкой сертификата и hostname; disable — только localhost.
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA=certs/supabase-root-2021-ca.crt

# Резервные копии на своём сервере (docker-compose.backup.yml, см. README).
BACKUP_DOCKER_NETWORK=
BACKUP_PGHOST=
BACKUP_PGPORT=5432
BACKUP_PGDATABASE=
BACKUP_PGUSER=
BACKUP_PGPASSWORD=
BACKUP_PGSSLMODE=verify-full
BACKUP_PGSSLROOTCERT=/etc/ssl/cert.pem
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
